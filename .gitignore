# Kernel module build output
*.ko
*.o
*.mod
*.mod.c
*.mod.o
*.cmd
.*.cmd
.tmp_versions/
Module.symvers
modules.order

# User-space build output
user/test_driver
user/test_driver_static
*.out
a.out

# Editor and OS files
.vscode/
.DS_Store

# Debugger and analysis output
*.dSYM/
core

user-data
*.pem
*.key
.env
private

# Local-only files: course materials, raw screenshots, anything private
# (the "private" rule above covers private/)
docs/notes/*.pdf

# Raw terminal captures show VM user, hostname, and IP; commit cropped copies instead
docs/screenshots/**/Screenshot From *
docs/screenshots/**/Screenshot 20*

# Submission and presentation files (Keynote .key files are already covered by *.key above)
*.zip
*.pptx

# Report and presentation working files stay local; only finished PDFs are published
docs/presentations/**
!docs/presentations/**/
!docs/presentations/final/Linux Driver Development Final.pdf
docs/reports/*.md
docs/notes/presentation/
